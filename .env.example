# ============================================================================
# LUME backend — one deployment per client. Every value below is specific to
# THIS client: never reuse a secret, database, bucket or API key across clients.
# Locally: copy to .env. On Railway: paste into the service's Variables tab.
# Variables marked (required) stop the server at boot if missing.
# ============================================================================

# ---- Server ----
PORT=3000
NODE_ENV=development            # "production" on Railway (selects MONGODB_URI over MONGODB_URI_DEV)

# ---- Property identity ----
PROPERTY_NAME=                  # (required) Display name, e.g. "Acme Resort Coorg". Used for default booking names.
AI_CONCIERGE_NAME=Eva           # Name the AI concierge introduces itself as
AI_PROPERTY_DESCRIPTION=        # Phrase for the concierge prompt, e.g. "a luxury resort in Coorg, India". Defaults to PROPERTY_NAME.

# ---- Database (MongoDB) — each client gets its own database ----
MONGODB_URI=                    # (required in production) Must include this client's database name: mongodb+srv://user:pass@host/acme-coorg?retryWrites=true
MONGODB_URI_DEV=                # (required when NODE_ENV != production) Same format; use a different database name from prod

# ---- Auth ----
JWT_SECRET=                     # (required) Long random string, unique per client. Rotating it logs everyone out.

# ---- URLs & CORS ----
GUEST_APP_URL=                  # (required) This client's guest app, e.g. https://guest.acme.com — also used in guest links
DASHBOARD_APP_URL=              # (required) This client's dashboard, e.g. https://dashboard.acme.com
CORS_ALLOWED_ORIGINS=           # Optional extra origins, comma-separated, exact match (no wildcards). Localhost is auto-allowed outside production.

# ---- Email (Resend) ----
RESEND_API_KEY=                 # Client's own Resend key
EMAIL_FROM=                     # Sender on the client's verified Resend domain, e.g. info@acme.com
NOTIFY_EMAILS=                  # Staff inbox(es) for booking/cancellation notices, comma-separated

# ---- Guest comms (Comms Hub) — sender identity is backend-owned, never editable by the property ----
COMMS_SCHEDULER_ENABLED=        # true to start sending automated guest emails/WhatsApp (leave off in dev)
COMMS_TIMEZONE=                 # Property timezone for send times and check-in dates, default Asia/Kolkata
COMMS_FROM_NAME=                # Display name on guest emails, default PROPERTY_NAME (ignored if EMAIL_FROM is "Name <addr>")
COMMS_TICK_MINUTES=             # How often the scheduler looks for due messages, default 5

# ---- WhatsApp Business (Meta Cloud API) ----
WHATSAPP_ENABLED=               # true once the number + templates are set up in Meta
WHATSAPP_ACCESS_TOKEN=          # System-user token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=       # Meta's id for the sending number
WHATSAPP_WABA_ID=               # WhatsApp Business Account id that owns the templates
WHATSAPP_API_VERSION=           # Graph API version, default v21.0
WHATSAPP_DISPLAY_NUMBER=        # e.g. +91 80000 12345 — shown read-only in the dashboard
WHATSAPP_DISPLAY_NAME=          # Verified business display name, default PROPERTY_NAME

# ---- AI ----
OPENAI_API_KEY=                 # Client's own OpenAI key

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Image storage (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Video storage (Cloudflare R2) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                  # Public base URL of the bucket (r2.dev subdomain or custom domain), no trailing slash

# ---- LeadSquared (optional — leave blank if the client doesn't use it) ----
LSQ_API_HOST=https://api.leadsquared.com
LSQ_ACTIVITY_TYPE_ID=           # Client's own activity type id
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_PROPERTY_NAME=              # Exact dropdown label for this property in the LSQ mx_Custom_2 field
