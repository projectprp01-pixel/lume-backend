# MongoDB Connection
# Used when NODE_ENV=production
MONGODB_URI=your_mongodb_connection_string_here
# Used otherwise (no database name in the path — it's pinned in code)
MONGODB_URI_DEV=your_mongodb_dev_connection_string_here

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (for ID uploads - FREE!)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URLs (for CORS)
GUEST_APP_URL=http://localhost:8080
DASHBOARD_APP_URL=http://localhost:8080

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# LeadSquared
LSQ_API_HOST=https://api.leadsquared.com
LSQ_ACTIVITY_TYPE_ID=277
LSQ_ACCESS_KEY=your_leadsquared_access_key
LSQ_SECRET_KEY=your_leadsquared_secret_key

# Per-property guest app URLs (JSON map, optional — overrides built-in defaults)
PROPERTY_APP_URLS={"default":"https://webappcoorg.evolveback.com","kabini":"https://webappkabini.evolveback.com","hampi":"https://webapphampi.evolveback.com"}
